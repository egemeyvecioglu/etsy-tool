# App settings
ETSY_TOOL_ENV=development
ETSY_TOOL_DEBUG=true
ETSY_TOOL_HOST=0.0.0.0
ETSY_TOOL_PORT=8000

# Database
ETSY_TOOL_DATABASE_URL=sqlite:///./etsy_tool.db

# Security / sessions
# Use a long random value in production.
ETSY_TOOL_SESSION_SECRET_KEY=replace-with-random-session-secret

# Token encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ETSY_TOOL_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key

# Etsy OAuth app credentials
ETSY_TOOL_OAUTH_CLIENT_ID=replace-with-etsy-client-id
ETSY_TOOL_OAUTH_CLIENT_SECRET=replace-with-etsy-client-secret
ETSY_TOOL_OAUTH_REDIRECT_URI=https://your-domain.com/oauth/etsy/callback

# Etsy scope list
ETSY_TOOL_ETSY_SCOPES=listings_r listings_w

# Testing-only bypass login (set false in production)
ETSY_TOOL_ALLOW_ADMIN_BYPASS_LOGIN=true

# Localization and UI schema
ETSY_TOOL_DEFAULT_LOCALE=en
ETSY_TOOL_SUPPORTED_LOCALES=en,tr
ETSY_TOOL_I18N_PATH=config/i18n
ETSY_TOOL_JOB_FORM_SCHEMA_PATH=config/ui/job_form.yaml

# Optional: point to an alternate YAML defaults file
# ETSY_TOOL_CONFIG_PATH=config/defaults.yaml
